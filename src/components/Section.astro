---
interface Props {
  heading?: string;
  text?: string;
  image?: string;
  imageAlt?: string;
}

const { heading, text, image, imageAlt } = Astro.props;
// Editors write "decorative" for images that add no meaning; screen readers then skip them.
const alt = imageAlt?.trim().toLowerCase() === 'decorative' ? '' : imageAlt?.trim();
---

<section class="section" data-reveal>
  {heading && <h2>{heading}</h2>}
  {text && <p>{text}</p>}
  {image && <img src={image} alt={alt} loading="lazy" />}
</section>
